<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/counter_minus"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/widget_minus"
        android:gravity="center"
        android:text="−"
        android:textColor="@color/widget_text"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/counter_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/counter_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/counter_plus"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/widget_plus"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/widget_accent"
        android:textSize="20sp" />
</LinearLayout>
